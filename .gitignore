# Secrets, private recordings, caches and generated data never belong in Git.
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.streamlit/secrets.toml
storage/*
!storage/.gitkeep
!storage/recordings/
storage/recordings/*
!storage/recordings/.gitkeep
*.sqlite
*.sqlite3
*.db
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.aac
model-cache/
*.log
*.bak
*.phase*.bak
.DS_Store
*.zip
*.tar.gz
*.pkl
*.pt
*.bin
*.safetensors
*.gguf
.vscode/
*.pem
*.key
*.cer
*.p12
*.pfx
